# OpenAI API Key for embeddings and LLM
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (defaults to gpt-4o if not specified)
LLM_MODEL=gpt-4o

# Supabase credentials
VITE_PUBLIC_BASE_URL=your_supabase_url_here
VITE_VITE_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Logging and debugging
# Set to 1 to enable debug logging, 0 for info level
DEBUG=0

# Application settings
# Maximum number of tokens to store in chat memory
MEMORY_TOKEN_LIMIT=100000 